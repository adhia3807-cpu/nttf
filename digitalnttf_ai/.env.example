# ============================================================
# Digital NTTF AI Automation - Environment Configuration (Optional)
# Credentials and Groq API Key can be provided directly via UI
# ============================================================

# Digital NTTF Student Portal Credentials
DIGITAL_NTTF_USERNAME=
DIGITAL_NTTF_PASSWORD=

# Groq AI API Key & Model
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Execution & Safety Settings
HEADLESS=false
AUTO_SUBMIT=true
RESUME_ENABLED=true

# AI Tuning & Timing
GROQ_REQUEST_DELAY=0.3
AI_CONFIDENCE_THRESHOLD=0.60
MAX_AI_RETRIES=2
BROWSER_SLOW_MO=150

# Target URLs (Default values)
DIGITAL_NTTF_BASE_URL=https://digitalnttf.com
DIGITAL_NTTF_LOGIN_URL=https://digitalnttf.com/login
DIGITAL_NTTF_LIBRARY_URL=https://digitalnttf.com/library
